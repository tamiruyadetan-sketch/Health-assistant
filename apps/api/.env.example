# Backend API
PORT=4000
NODE_ENV=development

# Comma-separated allowed origins. Leave unset (or '*') during local dev.
CORS_ORIGIN=*

# Optional: enables the real AI assistant via the Claude API.
# When unset, POST /api/ai/chat returns a safe canned reply.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5